# ============================================================
# Contoh konfigurasi environment untuk invela-be.
#
# Cara pakai:
#   1. Salin file ini menjadi .env  ->  cp .env.example .env
#   2. Isi nilainya (khususnya JWT_SECRET) di server, JANGAN di sini.
#
# File .env (berisi nilai asli) TIDAK ikut ter-commit ke git.
# File .env.example ini BOLEH di-commit karena tidak berisi rahasia.
# ============================================================

# Lingkungan aplikasi: "development" (default) atau "production".
# Di "production", JWT_SECRET WAJIB di-set atau aplikasi berhenti saat start.
APP_ENV=development

# Port HTTP server. Default: 8080
APP_PORT=8080

# Lokasi file database SQLite. Default: data/app.db
DB_PATH=data/app.db

# Kunci rahasia untuk menandatangani JWT.
# WAJIB di produksi. Kosongkan di file contoh ini.
# Buat nilai acak dengan salah satu perintah:
#   openssl rand -base64 48
#   head -c 48 /dev/urandom | base64
# Lalu tempel hasilnya sebagai nilai JWT_SECRET di server (bukan di file ini).
JWT_SECRET=
